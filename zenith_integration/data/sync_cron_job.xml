<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to sync credit limit payments -->
        <record id="cron_sync_credit_limit_payments" model="ir.cron">
            <field name="name">Sync Credit Limit Payments</field>
            <field name="model_id" ref="model_zenith_api_configuration"/>
            <field name="interval_number">1</field> <!-- Run every hour -->
            <field name="interval_type">hours</field>
            <field name="code">model.action_sync_credit_limit_payments()</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron job to sync flown tickets -->
        <record id="cron_sync_flown_tickets" model="ir.cron">
            <field name="name">Sync Flown Tickets</field>
            <field name="model_id" ref="model_zenith_api_configuration"/>
            <field name="interval_number">1</field> <!-- Run every hour -->
            <field name="interval_type">hours</field>
            <field name="code">model.action_sync_flown_tickets()</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron job to sync Odoo tickets -->
        <record id="cron_sync_odoo_tickets" model="ir.cron">
            <field name="name">Sync Odoo Tickets</field>
            <field name="model_id" ref="model_zenith_api_configuration"/>
            <field name="interval_number">1</field> <!-- Run every hour -->
            <field name="interval_type">hours</field>
            <field name="code">model.action_sync_odoo_tickets()</field>
            <field name="active" eval="True"/>
        </record>


<!--        Invoice Filling Cron job-->
          <record id="cron_sync_ticket_invoices" model="ir.cron">
            <field name="name">Sync Ticket Invoices</field>
            <field name="model_id" ref="model_ticket_transaction"/>
            <field name="interval_number">1</field> <!-- Run every hour -->
            <field name="interval_type">hours</field>
            <field name="code">model.action_invoice()</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>