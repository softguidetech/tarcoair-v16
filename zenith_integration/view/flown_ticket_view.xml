                        <field name="Flight_number" optional="hide"/>
                        <field name="local_dep_datetime" optional="hide"/>
                        <field name="local_arr_datetime" optional="hide"/>
                        <field name="departure_airport" optional="hide"/>
                        <field name="arrival_airport" optional="hide"/>
                        <field name="booking_class" optional="hide"/>
                        <field name="coupon_service" optional="hide"/>
                        <field name="fare_basis_class" optional="hide"/>
                        <field name="point_of_sale" optional="hide"/>
                        <field name="point_of_sale_code" optional="hide"/>
                        <field name="payment_type_identifier" optional="hide"/>
                        <field name="customer_name" optional="hide"/>
                        <field name="coupon_price_taxes_commission" optional="hide"/>
                        <field name="coupon_price_taxes" optional="hide"/>
                        <field name="total_turnover_amount" optional="hide"/>
                        <field name="coupon_commission_amount" optional="hide"/>
                        <field name="total_taxes_already" optional="hide"/>
                        <field name="coupon_taxes_amount" optional="hide"/>
                        <field name="iata_taxes_amount" optional="hide"/>
                        <field name="airline_taxes_amount" optional="hide"/>
                        <field name="yq_tax_amount" optional="hide"/>
                        <field name="yr_tax_amount" optional="hide"/>
                        <field name="service_fee_taxes_amount" optional="hide"/>
                        <field name="issuance_tax_amount" optional="hide"/>
                        <field name="total_amount" optional="hide"/>
                        <field name="total_amount_excl" optional="hide"/>
                        <field name="coupon_penalty_amount" optional="hide"/>
                        <field name="excess_baggage_weight" optional="hide"/>
                        <field name="excess_baggage_fee_collected" optional="hide"/>
                        <field name="acm" optional="hide"/>
                        <field name="adm" optional="hide"/>
                        <field name="coupon_mileage" optional="hide"/>
                        <field name="ticket_mileage" optional="hide"/>
                        <field name="pnr_of_operating_airline" optional="hide"/>
                        <field name="designator_of_operating_airline" optional="hide"/>
                        <field name="flight_number_on_operating_airline" optional="hide"/>
                        <field name="booking_class_on_operating_airline" optional="hide"/>
                        <field name="pnr_of_marketing_airline" optional="hide"/>
                        <field name="designator_of_marketing_airline" optional="hide"/>
                        <field name="flight_number_of_marketing_airline" optional="hide"/>
                        <field name="sales_currency" optional="hide"/>
                        <field name="iata_passenger_type" optional="hide"/>
                        <field name="passenger_civility" optional="hide"/>
                        <field name="passenger_surname" optional="hide"/>
                        <field name="passenger_first_name" optional="hide"/>
                        <field name="datetime_lt_of_issuance" optional="hide"/>
            </tree>
        </field>
    </record>

     <record id="action_zenith_flown_ticket" model="ir.actions.act_window">
        <field name="name">Flown Ticket</field>
        <field name="res_model">flown.ticket</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_zenith_flown_ticket" parent="menu_zenith" name="Flown Ticket"
              action="action_zenith_flown_ticket"/>

</odoo>
