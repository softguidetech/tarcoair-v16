<?xml version="1.0"?>
<odoo>

    <record id="view_zenith_credit_limit_form" model="ir.ui.view">
        <field name="name">zenith.credit.limit.form</field>
        <field name="model">credit.limit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="cash_statement_id" readonly="1"/>
<!--                            <field name="customer_id" readonly="1"/>-->
                            <field name="customer_ref" readonly="1"/>
                            <field name="agency_name" readonly="1"/>
                            <field name="date_of_payment" readonly="1"/>
                            <field name="payment_amount" readonly="1"/>
                            <field name="sale_currency" readonly="1"/>
                            <field name="available_credit_before" readonly="1"/>
                            <field name="currency_before" readonly="1"/>
                            <field name="available_credit_after" readonly="1"/>
                            <field name="currency_after" readonly="1"/>
                            <field name="payment_registered" readonly="1"/>
                            <field name="authorized_credit" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_credit" readonly="1"/>
                            <field name="total_sold" readonly="1"/>
                            <field name="sold_currency" readonly="1"/>
                            <field name="total_paid" readonly="1"/>
                            <field name="total_paid_currency" readonly="1"/>
                            <field name="reference_number" readonly="1"/>
                            <field name="sales_report" readonly="1"/>
                            <field name="fop" readonly="1"/>
                            <field name="transaction_number" readonly="1"/>
                            <field name="payment_amount_base_currency" readonly="1"/>
                            <field name="available_credit_before_payment" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credit_limit_view_tree" model="ir.ui.view">
        <field name="name">Credit Limit</field>
        <field name="model">credit.limit</field>
        <field name="arch" type="xml">
            <tree string="credit_limit_list">
                <field name="date"/>
                <field name="cash_statement_id"/>
                <field name="customer_ref"/>
                <field name="agency_name"/>
                <field name="date_of_payment"/>
                <field name="payment_amount"/>
                <field name="sale_currency"/>
                <field name="available_credit_before"/>
                <field name="currency_before"/>
                <field name="available_credit_after"/>
                <field name="currency_after"/>


                <field name="payment_registered" optional="hide"/>
                <field name="authorized_credit" optional="hide"/>
                <field name="currency_credit" optional="hide"/>
                <field name="total_sold" optional="hide"/>
                <field name="sold_currency" optional="hide"/>
                <field name="total_paid" optional="hide"/>
                <field name="total_paid_currency" optional="hide"/>
                <field name="reference_number" optional="hide"/>
                <field name="sales_report" optional="hide"/>
                <field name="fop" optional="hide"/>
                <field name="transaction_number" optional="hide"/>

                <field name="payment_amount_base_currency" optional="hide"/>
                <field name="available_credit_before_payment" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_zenith_credit_limit" model="ir.actions.act_window">
        <field name="name">Credit Limit</field>
        <field name="res_model">credit.limit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_zenith_credit_limit" parent="menu_zenith" name="Credit Limit"
              action="action_zenith_credit_limit"/>

</odoo>
