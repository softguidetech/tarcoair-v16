<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Inherit the res.partner form view -->
        <record model="ir.ui.view" id="account_move_form_view_inherit">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='aml_tab']" position="after">
                    <page name="zenith" string="Zenith Integration">
                        <group col="4" colspan="4">
                            <field name="pnr_alpha" readonly="1" />
                            <field name="iata_agency_code" readonly="1" />
                            <field name="pos" readonly="1" />
                            <field name="customer_name" readonly="1" />
                            <field name="customer_zenith_id" readonly="1" />
                            <field name="transaction_name" readonly="1" />
                            <field name="payment_type" readonly="1" />
                            <field name="balance_sales_currency" readonly="1" />
                            <field name="sale_agent" readonly="1" />
                            <field name="ticket_number" readonly="1" />
                            <field name="heading_st_payment" readonly="1" />
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>