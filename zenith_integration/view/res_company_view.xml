<?xml version="1.0"?>
<odoo>

    <record id="view_company_form_custom" model="ir.ui.view">
        <field name="name">company.form.custom</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page name="zenith" string="Zenith Integration">
                    <group colspan="4" col="4">
                        <field name="sale_account_id"/>
                        <field name="zenith_partner_id"/>
                        <field name="zenith_pos"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
