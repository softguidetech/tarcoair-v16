<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form view for API Configuration -->
        <record id="view_api_configuration_form" model="ir.ui.view">
            <field name="name">zenith.api.configuration.form</field>
            <field name="model">zenith.api.configuration</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_sync_credit_limit_payments"
                                type="object"
                                class="btn btn-primary"
                                string="Sync Credit Limit Payments" />
                        <button name="action_sync_flown_tickets"
                                type="object"
                                class="btn btn-primary"
                                string="Sync Flown Tickets" />
                        <button name="action_sync_odoo_tickets"
                                type="object"
                                class="btn btn-primary"
                                string="Sync Odoo Tickets" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="code" required="1"/>
                                <field name="login" required="1"/>
                                <field name="password" required="1"/>
                            </group>
                            <group>
                                <field name="air_line_vendor_id" required="1"/>
                                <field name="credit_limit_last_update"/>
                                <field name="tickets_last_update" />
                                <field name="flow_tickets_last_update" />
                            </group>
                        </group>
                        <group>
                            <field name="url" required="1"/>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>
        <!-- List view for API Configuration -->
        <record id="view_api_configuration_list" model="ir.ui.view">
            <field name="name">zenith.api.configuration.list</field>
            <field name="model">zenith.api.configuration</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="login"/>
                    <field name="air_line_vendor_id"/>
                    <field name="credit_limit_last_update"/>
                    <field name="tickets_last_update"/>
                    <field name="flow_tickets_last_update"/>
                    <field name="url" />
                </tree>
            </field>
        </record>

        <!-- Action for API Configuration List View -->
        <record id="action_api_configuration_list" model="ir.actions.act_window">
            <field name="name">API Configuration</field>
            <field name="res_model">zenith.api.configuration</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem id="menu_zenith_configuration" name="Configuration" parent="menu_zenith"/>

        <menuitem id="menu_zenith_api_configuration" parent="menu_zenith_configuration" name="API Configuration"
                  action="action_api_configuration_list"/>
    </data>
</odoo>